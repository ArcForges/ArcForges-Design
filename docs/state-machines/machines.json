      "owner": "Fleet module",
      "initial": [
        "ACCEPTED"
      ],
      "terminal": [
        "SUCCEEDED",
        "FAILED",
        "REJECTED_BY_NODE",
        "EXPIRED",
        "CANCELLED"
      ],
      "transitions": [
        {
          "from": [
            "ACCEPTED"
          ],
          "to": "DELIVERED",
          "on": "FleetHub delivered the signed envelope to the node socket"
        },
        {
          "from": [
            "DELIVERED"
          ],
          "to": "SUCCEEDED",
          "on": "signed result with a receipt"
        },
        {
          "from": [
            "DELIVERED"
          ],
          "to": "FAILED",
          "on": "signed result with an error"
        },
        {
          "from": [
            "DELIVERED"
          ],
          "to": "REJECTED_BY_NODE",
          "on": "node signature, expiry, target or remote-control policy check failed"
        },
        {
          "from": [
            "ACCEPTED",
            "DELIVERED"
          ],
          "to": "EXPIRED",
          "on": "expiry (<= 5 min) passed without a result",
          "effect": "never executed late"
        },
        {
          "from": [
            "ACCEPTED"
          ],
          "to": "CANCELLED",
          "on": "FleetService.CancelNodeCommand"
        }
      ]
