{
  "schema": 1,
  "note": "Canonical state machines. README.md is generated from this file by tools/check_design.py --write. States must equal the named proto enum (minus UNSPECIFIED) unless listed in pseudo_states or response_only. Transitions leaving a terminal state must be marked reopen (explicit manual action).",
  "machines": [
    {
      "id": "SM-TASK",
      "title": "Task",
      "enum": "arcforges.node.v1.TaskState",
      "persisted": "node store task.state",
      "owner": "Scheduler",
      "initial": [
        "QUEUED",
        "WAITING_DEPENDENCY",
        "RUNNING"
      ],
      "initial_guards": {
        "QUEUED": "kind != ADOPTED; ordinary submission",
        "WAITING_DEPENDENCY": "kind != ADOPTED; submission with unmet dependencies",
        "RUNNING": "kind = ADOPTED; successful explicit HUMAN adoption records the synthetic task and its one ADOPTED attempt together"
      },
      "terminal": [
        "SUCCEEDED",
        "FAILED",
        "CANCELLED",
        "LOST"
      ],
      "transitions": [
        {
          "from": [
            "WAITING_DEPENDENCY"
          ],
          "to": "QUEUED",
          "on": "dependencies satisfied",
          "guard": "kind != ADOPTED"
        },
        {
          "from": [
            "WAITING_DEPENDENCY"
          ],
          "to": "CANCELLED",
          "on": "dependency failed or cancelled (condition SUCCEEDED); TaskService.CancelTask",
          "guard": "kind != ADOPTED"
        },
        {
          "from": [
            "QUEUED"
          ],
          "to": "RUNNING",
          "on": "admitted locally; attempt created",
          "guard": "budget, pool, global limits (03 section 4); kind != ADOPTED"
        },
        {
          "from": [
            "QUEUED"
          ],
          "to": "PLACING",
          "on": "placement chose a peer (placement ANY or SPECIFIC_NODE)",
          "guard": "peer policy (no entitlement: LAN is free, AD-0015); kind != ADOPTED"
        },
        {
          "from": [
            "PLACING"
          ],
          "to": "RUNNING",
          "on": "remote attempt started",
          "guard": "kind != ADOPTED"
        },
        {
          "from": [
            "PLACING"
          ],
          "to": "QUEUED",
          "on": "offer declined or expired; transfer failed before start",
          "effect": "re-placement; any side-effect class",
          "guard": "kind != ADOPTED"
        },
        {
          "from": [
            "RUNNING"
          ],
          "to": "PAUSED",
          "on": "TaskService.PauseTask; pressure freeze",
          "guard": "pause SUPPORTED and task pausable; kind != ADOPTED"
        },
        {
          "from": [
            "PAUSED"
          ],
          "to": "RUNNING",
          "on": "TaskService.ResumeTask; pressure recovered",
          "guard": "kind != ADOPTED"
        },
        {
          "from": [
            "RUNNING"
          ],
          "to": "SUCCEEDED",
          "on": "attempt finished with exit code 0",
          "guard": "kind != ADOPTED"
        },
        {
          "from": [
            "RUNNING"
          ],
          "to": "RETRY_WAIT",
          "on": "attempt failed, LOST or PREEMPTED",
          "guard": "retry rules allow (AD-0006 section 4) and attempts remain; kind != ADOPTED"
        },
        {
          "from": [
            "RETRY_WAIT"
          ],
          "to": "QUEUED",
          "on": "backoff elapsed",
          "guard": "kind != ADOPTED"
        },
        {
          "from": [
            "RUNNING"
          ],
          "to": "FAILED",
          "on": "attempt finished non-zero, timed out, OOM, CPU limit or termination incomplete",
          "guard": "no retry applies; kind != ADOPTED"
        },
        {
          "from": [
            "RUNNING"
          ],
          "to": "LOST",
          "on": "attempt LOST (boot changed, container missing, peer lease ended)",
          "guard": "not retryable; for ADOPTED, its attempt is RUNNING or STOPPING and the boot changed or adoption container cannot be reopened"
        },
        {
          "from": [
            "QUEUED",
            "PLACING",
            "RUNNING",
            "PAUSED",
            "RETRY_WAIT"
          ],
          "to": "CANCELLED",
          "on": "TaskService.CancelTask; session ended (stop_with_session); node shutdown for kill_with_node",
          "guard": "kind != ADOPTED"
        },
        {
          "from": [
            "FAILED",
            "CANCELLED",
            "LOST"
          ],
          "to": "QUEUED",
          "on": "TaskService.RetryTask",
          "effect": "new attempt number",
          "reopen": true,
          "guard": "kind != ADOPTED"
        },
        {
          "from": [
            "RUNNING"
          ],
          "to": "CANCELLED",
          "on": "explicit cancellation of the adopted container completed",
          "guard": "kind = ADOPTED; adoption container is empty",
          "effect": "one attempt FINISHED with CANCELLED/HAPPENED; no retry"
        },
        {
          "from": [
            "RUNNING"
          ],
          "to": "LOST",
          "on": "adoption container emptied without cancellation",
          "guard": "kind = ADOPTED",
          "effect": "one attempt FINISHED with LOST/UNKNOWN; no exit status and no retry"
        }
      ]
    },
    {
      "id": "SM-ATTEMPT",
      "title": "Attempt",
      "enum": "arcforges.node.v1.AttemptState",
      "persisted": "node store attempt.state",
      "owner": "Supervisor",
      "initial": [
        "CREATED",
        "STARTING",
        "RUNNING"
      ],
      "initial_guards": {
        "CREATED": "kind != ADOPTED; remote placement or cache restore",
        "STARTING": "kind = LOCAL; durable local launch intent",
        "RUNNING": "kind = ADOPTED; successful explicit HUMAN adoption, with no command launch"
      },
      "terminal": [
        "FINISHED"
      ],
      "transitions": [
        {
          "from": [
            "CREATED"
          ],
          "to": "TRANSFERRING",
          "on": "remote placement: inputs transferring",
          "guard": "kind != ADOPTED"
        },
        {
          "from": [
            "CREATED"
          ],
          "to": "STARTING",
          "on": "local admission commits launch intent and reserves the container name (also the initial local state); before creating the OS container",
          "guard": "kind != ADOPTED"
        },
        {
          "from": [
            "TRANSFERRING"
          ],
          "to": "STARTING",
          "on": "inputs complete on the executor",
          "guard": "kind != ADOPTED"
        },
        {
          "from": [
            "STARTING"
          ],
          "to": "RUNNING",
          "on": "process started (job resumed or unit job done)",
          "guard": "kind != ADOPTED"
        },
        {
          "from": [
            "STARTING"
          ],
          "to": "FINISHED",
          "on": "spawn failed or policy denied",
          "effect": "termination SPAWN_FAILED or POLICY_DENIED; effect DID_NOT_HAPPEN",
          "guard": "kind != ADOPTED"
        },
        {
          "from": [
            "RUNNING"
          ],
          "to": "PAUSING",
          "on": "freeze requested",
          "guard": "kind != ADOPTED"
        },
        {
          "from": [
            "PAUSING"
          ],
          "to": "PAUSED",
          "on": "freeze confirmed (cgroup.events frozen 1)",
          "guard": "kind != ADOPTED"
        },
        {
          "from": [
            "PAUSED"
          ],
          "to": "RUNNING",
          "on": "thaw",
          "guard": "kind != ADOPTED"
        },
        {
          "from": [
            "RUNNING",
            "PAUSING",
            "PAUSED"
          ],
          "to": "STOPPING",
          "on": "cancel, timeout, CPU/output/disk limit, preemption or kill_with_node shutdown",
          "effect": "commit STOPPING with the pending cause and redacted detail before applying the platform stop; a restart continues that stop (architecture 04 sections 6 and 9)",
          "guard": "kind != ADOPTED"
        },
        {
          "from": [
            "STARTING"
          ],
          "to": "STOPPING",
          "on": "cancel, timeout, CPU/output/disk limit, preemption or kill_with_node shutdown while launch is pending",
          "effect": "commit STOPPING with the pending cause and redacted detail before applying the platform stop; a restart continues that stop (architecture 04 sections 6 and 9)",
          "guard": "kind != ADOPTED"
        },
        {
          "from": [
            "STARTING",
            "RUNNING",
            "PAUSING",
            "PAUSED"
          ],
          "to": "FINALIZING",
          "on": "completion evidence is available (exit record or platform completion); a fast root can exit before RUNNING is published",
          "effect": "end steps and leftover rundown precede the exit evidence; persist FINALIZING before final output/accounting/result recording",
          "guard": "kind != ADOPTED"
        },
        {
          "from": [
            "STOPPING"
          ],
          "to": "FINALIZING",
          "on": "container empty, or verification window (5 s) elapsed",
          "effect": "retain the pending stop cause and detail; TERMINATION_INCOMPLETE when processes remain; persist before final result recording",
          "guard": "kind != ADOPTED"
        },
        {
          "from": [
            "CREATED"
          ],
          "to": "FINALIZING",
          "on": "result-cache hit (CACHE_RESTORE attempt; RESTORE mode is roadmap RM-04, not in release 1)",
          "guard": "kind != ADOPTED"
        },
        {
          "from": [
            "FINALIZING"
          ],
          "to": "FINISHED",
          "on": "output, accounting and records finalized",
          "guard": "kind != ADOPTED"
        },
        {
          "from": [
            "CREATED",
            "TRANSFERRING",
            "STARTING",
            "RUNNING",
            "PAUSING",
            "PAUSED",
            "STOPPING",
            "FINALIZING"
          ],
          "to": "FINISHED",
          "on": "recovery: container missing, boot changed, or peer lease ended",
          "effect": "termination LOST; effect UNKNOWN",
          "guard": "for ADOPTED, only RUNNING or STOPPING; boot changed or adoption container cannot be reopened"
        },
        {
          "from": [
            "RUNNING"
          ],
          "to": "STOPPING",
          "on": "TaskService.CancelTask requests termination of the adopted container",
          "guard": "kind = ADOPTED",
          "effect": "record and journal STOPPING in the cancel command; no command launch or managed end steps"
        },
        {
          "from": [
            "STOPPING"
          ],
          "to": "FINISHED",
          "on": "cancelled adoption container is empty",
          "guard": "kind = ADOPTED",
          "effect": "termination CANCELLED; effect HAPPENED; no captured exit code, output or managed FINALIZING phase"
        },
        {
          "from": [
            "RUNNING"
          ],
          "to": "FINISHED",
          "on": "adoption container emptied without cancellation",
          "guard": "kind = ADOPTED",
          "effect": "termination LOST; effect UNKNOWN; node is not the parent and has no exit status"
        }
      ]
    },
    {
      "id": "SM-FINDING",
      "title": "Finding",
      "enum": "arcforges.node.v1.FindingState",
      "persisted": "node store finding.state",
      "owner": "Diagnosis",
      "initial": [
        "OPEN"
      ],
      "terminal": [
        "RESOLVED",
        "AUTO_RESOLVED"
      ],
      "transitions": [
        {
          "from": [
            "OPEN"
          ],
          "to": "ACKNOWLEDGED",
          "on": "DiagnosisService.AcknowledgeFinding"
        },
        {
          "from": [
            "OPEN",
            "ACKNOWLEDGED"
          ],
          "to": "MUTED",
          "on": "DiagnosisService.MuteFinding"
        },
        {
          "from": [
            "MUTED"
          ],
          "to": "OPEN",
          "on": "mute expired while the condition persists"
        },
        {
          "from": [
            "OPEN",
            "ACKNOWLEDGED"
          ],
          "to": "RESOLVED",
          "on": "DiagnosisService.ApplyRemedy succeeded and the condition cleared"
        },
        {
          "from": [
            "OPEN",
            "ACKNOWLEDGED",
            "MUTED"
          ],
          "to": "AUTO_RESOLVED",
          "on": "condition cleared for 2 consecutive checks"
        }
      ]
    },
    {
      "id": "SM-NODE",
      "title": "Node lifecycle",
      "enum": "arcforges.node.v1.NodeLifecycleState",
      "persisted": "in memory; journaled as NodeStatusChanged events",
      "owner": "Host",
      "pseudo_states": [
        "STOPPED"
      ],
      "initial": [
        "STARTING"
      ],
      "terminal": [
        "STOPPED"
      ],
      "transitions": [
        {
          "from": [
            "STARTING"
          ],
          "to": "RECOVERING",
          "on": "store opened and migrated (02 section 2 steps 1-4)"
        },
        {
          "from": [
            "RECOVERING"
          ],
          "to": "READY",
          "on": "recovery done, enforcement self-test passed, endpoint listening"
        },
        {
          "from": [
            "RECOVERING"
          ],
          "to": "DEGRADED",
          "on": "recovery done; some capability missing (OBSERVE_ONLY or PARTIAL)"
        },
        {
          "from": [
            "READY"
          ],
          "to": "DEGRADED",
          "on": "capability lost (e.g. user manager restarted without delegation), or a store write failed for lack of disk space (reason store_out_of_space; 06 section 5)"
        },
        {
          "from": [
            "DEGRADED"
          ],
          "to": "READY",
          "on": "capability restored, or disk space returned and a store write succeeded"
        },
        {
          "from": [
            "READY",
            "DEGRADED"
          ],
          "to": "STOPPING",
          "on": "NodeService.StopNode; OS logoff; service stop"
        },
        {
          "from": [
            "READY",
            "DEGRADED"
          ],
          "to": "UPDATING",
          "on": "update switch (13 section 5.3)"
        },
        {
          "from": [
            "STOPPING",
            "UPDATING"
          ],
          "to": "STOPPED",
          "on": "process exit (code 0, or 75 for an update restart)"
        },
        {
          "from": [
            "STARTING",
            "RECOVERING"
          ],
          "to": "STOPPED",
          "on": "fatal startup error (store incompatible, endpoint held by another instance)"
        }
      ]
    },
    {
      "id": "SM-GUEST-LINK",
      "title": "WSL guest link (host side): retired 2026-10-21 by AD-0018, never entered; kept as history",
      "enum": "arcforges.node.v1.GuestLinkState",
      "persisted": "node store guest_link.state (retired table, never written)",
      "owner": "none (the guest manager is retired by AD-0018)",
      "initial": [
        "NOT_INSTALLED",
        "DISCOVERED"
      ],
      "terminal": [],
      "transitions": [
        {
          "from": [
            "NOT_INSTALLED"
          ],
          "to": "DISCOVERED",
          "on": "guest node installed in the distribution (user action)"
        },
        {
          "from": [
            "DISCOVERED"
          ],
          "to": "CONNECTING",
          "on": "host starts the wsl.exe bridge"
        },
        {
          "from": [
            "CONNECTING"
          ],
          "to": "LINKED",
          "on": "GuestLinkService.OpenLink hello received",
          "guard": "link token valid; protocol compatible"
        },
        {
          "from": [
            "CONNECTING"
          ],
          "to": "LOST",
          "on": "bridge exited or no hello within 30 s"
        },
        {
          "from": [
            "LINKED"
          ],
          "to": "DEGRADED",
          "on": "guest reports degraded enforcement (no systemd, missing controllers)"
        },
        {
          "from": [
            "DEGRADED"
          ],
          "to": "LINKED",
          "on": "guest capabilities restored"
        },
        {
          "from": [
            "LINKED",
            "DEGRADED"
          ],
          "to": "LOST",
          "on": "30 s without frames, or bridge exit",
          "effect": "finding GUEST_LINK_LOST; the guest keeps its last allocation until lease_until, then admits only within the standalone allocation; the host keeps the guest's reserved allocation (the last acknowledged one and any larger unacknowledged push) until the guest acknowledges a smaller one after reconnecting, or its distribution is observed stopped (architecture 03 section 6)"
        },
        {
          "from": [
            "LOST"
          ],
          "to": "CONNECTING",
          "on": "bounded backoff retry (1 s to 60 s)"
        },
        {
          "from": [
            "DISCOVERED",
            "CONNECTING",
            "LINKED",
            "DEGRADED",
            "LOST"
          ],
          "to": "DISABLED",
          "on": "ResourceService.SetGuestLink enabled=false",
          "effect": "the guest's reserved allocation stays, whether the link was up or lost, until the guest acknowledges a smaller one or its distribution is observed stopped (architecture 03 section 6)"
        },
        {
          "from": [
            "DISABLED"
          ],
          "to": "CONNECTING",
          "on": "ResourceService.SetGuestLink enabled=true"
        },
        {
          "from": [
            "DISCOVERED",
            "LOST",
            "DISABLED"
          ],
          "to": "NOT_INSTALLED",
          "on": "distribution or guest binary removed",
          "effect": "the guest's reserved allocation stays, whether the link was up or lost, until the guest acknowledges a smaller one or its distribution is observed stopped (architecture 03 section 6)"
        }
      ]
    },
    {
      "id": "SM-PAIRING",
      "title": "LAN pairing (local confirmation): out of current delivery since 2026-10-28 (AD-0021 §12); kept as history",
      "enum": "arcforges.node.v1.PairingState",
      "persisted": "node store pairing.state (secrets in memory)",
      "owner": "Peer manager",
      "initial": [
        "REQUESTED",
        "INCOMING"
      ],
      "terminal": [
        "PAIRED",
        "REJECTED",
        "MISMATCH",
        "EXPIRED",
        "CANCELLED",
        "BLOCKED"
      ],
      "transitions": [
        {
          "from": [
            "REQUESTED"
          ],
          "to": "EXCHANGING",
          "on": "responder accepted (PairingService.AwaitResponse)"
        },
        {
          "from": [
            "INCOMING"
          ],
          "to": "EXCHANGING",
          "on": "PeerService.RespondToPairing accept"
        },
        {
          "from": [
            "REQUESTED",
            "INCOMING"
          ],
          "to": "REJECTED",
          "on": "responder rejected"
        },
        {
          "from": [
            "EXCHANGING"
          ],
          "to": "AWAITING_CONFIRMATION",
          "on": "commitment verified (PairingService.Reveal); SAS computed"
        },
        {
          "from": [
            "EXCHANGING"
          ],
          "to": "MISMATCH",
          "on": "commitment invalid"
        },
        {
          "from": [
            "AWAITING_CONFIRMATION"
          ],
          "to": "CONFIRMED_LOCALLY",
          "on": "PeerService.ConfirmPairing digits_match=true"
        },
        {
          "from": [
            "AWAITING_CONFIRMATION",
            "CONFIRMED_LOCALLY"
          ],
          "to": "MISMATCH",
          "on": "either user reports different digits"
        },
        {
          "from": [
            "CONFIRMED_LOCALLY"
          ],
          "to": "PAIRED",
          "on": "the other side confirmed",
          "effect": "fingerprints pinned; peer PAIRED (PINNED); default policy status-only"
        },
        {
          "from": [
            "REQUESTED",
            "INCOMING",
            "EXCHANGING",
            "AWAITING_CONFIRMATION",
            "CONFIRMED_LOCALLY"
          ],
          "to": "EXPIRED",
          "on": "120 s elapsed"
        },
        {
          "from": [
            "REQUESTED",
            "INCOMING",
            "EXCHANGING",
            "AWAITING_CONFIRMATION",
            "CONFIRMED_LOCALLY"
          ],
          "to": "CANCELLED",
          "on": "PeerService.CancelPairing; PairingService.Abort"
        },
        {
          "from": [
            "REQUESTED",
            "INCOMING"
          ],
          "to": "BLOCKED",
          "on": "5 failed attempts for the peer within an hour"
        }
      ]
    },
    {
      "id": "SM-REMOTE-ATTEMPT",
      "title": "Remote attempt (executor side): out of current delivery since 2026-10-28 (AD-0021 §12); kept as history",
      "enum": "arcforges.peer.v1.RemoteAttemptState",
      "persisted": "executor node store remote_attempt.state; origin mirrors as ATTEMPT_KIND_REMOTE",
      "owner": "Placement",
      "initial": [
        "RESERVED"
      ],
      "terminal": [
        "RELEASED",
        "CANCELLED",
        "PREEMPTED"
      ],
      "transitions": [
        {
          "from": [
            "RESERVED"
          ],
          "to": "RECEIVING_INPUTS",
          "on": "executor starts pulling the input manifest"
        },
        {
          "from": [
            "RECEIVING_INPUTS"
          ],
          "to": "QUEUED",
          "on": "inputs materialized"
        },
        {
          "from": [
            "QUEUED"
          ],
          "to": "RUNNING",
          "on": "local admission granted the reservation"
        },
        {
          "from": [
            "RUNNING"
          ],
          "to": "FINISHED",
          "on": "attempt finished while the origin holds the lease"
        },
        {
          "from": [
            "RUNNING"
          ],
          "to": "RETAINED",
          "on": "attempt finished after the origin went silent beyond the lease (FINISH_AND_RETAIN)"
        },
        {
          "from": [
            "FINISHED",
            "RETAINED"
          ],
          "to": "RELEASED",
          "on": "PlacementService.ReleaseRemoteAttempt; retention (7 days) ended"
        },
        {
          "from": [
            "RESERVED",
            "RECEIVING_INPUTS",
            "QUEUED",
            "RUNNING"
          ],
          "to": "CANCELLED",
          "on": "PlacementService.CancelRemoteAttempt; lease expired with CANCEL; executor user cancelled"
        },
        {
          "from": [
            "QUEUED",
            "RUNNING"
          ],
          "to": "PREEMPTED",
          "on": "executor pressure or policy"
        }
      ]
    },
    {
      "id": "SM-CLEANUP-PLAN",
      "title": "Cleanup plan",
      "enum": "arcforges.node.v1.CleanupPlanState",
      "persisted": "node store cleanup_plan.state",
      "owner": "Cleanup executor",
      "initial": [
        "PLANNED"
      ],
      "terminal": [
        "COMPLETED",
        "PARTIAL",
        "EXPIRED",
        "CANCELLED"
      ],
      "transitions": [
        {
          "from": [
            "PLANNED"
          ],
          "to": "AWAITING_APPROVAL",
          "on": "StorageService.ExecuteCleanup by a caller who needs approval"
        },
        {
          "from": [
            "PLANNED"
          ],
          "to": "EXECUTING",
          "on": "StorageService.ExecuteCleanup permitted",
          "guard": "digest matches; not expired"
        },
        {
          "from": [
            "AWAITING_APPROVAL"
          ],
          "to": "EXECUTING",
          "on": "approval approved"
        },
        {
          "from": [
            "AWAITING_APPROVAL"
          ],
          "to": "CANCELLED",
          "on": "approval denied, cancelled or expired"
        },
        {
          "from": [
            "EXECUTING"
          ],
          "to": "COMPLETED",
          "on": "every selected item DONE"
        },
        {
          "from": [
            "EXECUTING"
          ],
          "to": "PARTIAL",
          "on": "some items IN_USE, CHANGED, REFERENCED, NOT_ALLOWED or FAILED"
        },
        {
          "from": [
            "PLANNED",
            "AWAITING_APPROVAL"
          ],
          "to": "EXPIRED",
          "on": "60 minutes after creation"
        },
        {
          "from": [
            "PLANNED"
          ],
          "to": "CANCELLED",
          "on": "StorageService.CancelCleanupPlan"
        }
      ]
    },
    {
      "id": "SM-WORKTREE",
      "title": "Managed worktree",
      "enum": "arcforges.node.v1.WorkspaceState",
      "persisted": "node store workspace.state (kind MANAGED_WORKTREE)",
      "owner": "Workspace manager",
      "initial": [
        "CREATING"
      ],
      "terminal": [
        "REMOVED"
      ],
      "transitions": [
        {
          "from": [
            "CREATING"
          ],
          "to": "ACTIVE",
          "on": "git worktree add succeeded (node job)"
        },
        {
          "from": [
            "CREATING"
          ],
          "to": "FAILED",
          "on": "node job failed"
        },
        {
          "from": [
            "ACTIVE"
          ],
          "to": "IDLE",
          "on": "no task, session or lock for 14 days"
        },
        {
          "from": [
            "IDLE"
          ],
          "to": "ACTIVE",
          "on": "used by a task or session"
        },
        {
          "from": [
            "ACTIVE",
            "IDLE"
          ],
          "to": "REMOVING",
          "on": "WorkspaceService.RemoveWorktree; approved cleanup item",
          "guard": "clean (no staged, unstaged or untracked changes)"
        },
        {
          "from": [
            "ACTIVE",
            "IDLE"
          ],
          "to": "ARCHIVING",
          "on": "WorkspaceService.RemoveWorktree with archive_changes (approved), with the ignored-files decision when the removal plan lists ignored files",
          "guard": "dirty; nothing listed as blocking; no task, session or lock uses the worktree"
        },
        {
          "from": [
            "ARCHIVING"
          ],
          "to": "REMOVING",
          "on": "archive verified: snapshot commits I and W written, the bundle fetched over the base ref into a temporary repository with the same commit IDs, live files matched by blob ID, mode and bytes, the index matched to I (06 section 3)"
        },
        {
          "from": [
            "ARCHIVING"
          ],
          "to": "ACTIVE",
          "on": "archive creation or verification failed; nothing removed; finding raised"
        },
        {
          "from": [
            "REMOVING"
          ],
          "to": "REMOVED",
          "on": "git worktree remove succeeded"
        },
        {
          "from": [
            "REMOVING"
          ],
          "to": "ACTIVE",
          "on": "removal failed (in use or git refused)"
        },
        {
          "from": [
            "FAILED"
          ],
          "to": "REMOVED",
          "on": "partial directory cleaned up"
        }
      ]
    },
    {
      "id": "SM-SESSION",
