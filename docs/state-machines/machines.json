        },
        {
          "from": [
            "IDLE"
          ],
          "to": "ACTIVE",
          "on": "activity"
        },
        {
          "from": [
            "ACTIVE",
            "IDLE"
          ],
          "to": "ENDED",
          "on": "SessionEnd hook; agent root process exited; 24 h inactivity; SessionService.EndSession",
          "effect": "services with stop_with_session stop"
        }
      ]
    },
    {
      "id": "SM-APPROVAL",
      "title": "Approval",
      "enum": "arcforges.node.v1.ApprovalState",
      "persisted": "node store approval.state",
      "owner": "Approval service",
      "initial": [
        "PENDING"
      ],
      "terminal": [
        "EXECUTED",
        "FAILED",
        "DENIED",
        "EXPIRED",
        "CANCELLED"
      ],
      "transitions": [
        {
          "from": [
            "PENDING"
          ],
          "to": "APPROVED",
          "on": "ApprovalService.DecideApproval approve",
          "guard": "approver HUMAN, or REMOTE with step-up and remote.allow_approvals"
        },
        {
          "from": [
            "APPROVED"
          ],
          "to": "EXECUTED",
          "on": "captured request executed with its command_id"
        },
        {
          "from": [
            "APPROVED"
          ],
          "to": "FAILED",
          "on": "captured request failed (outcome stored)"
        },
        {
          "from": [
            "PENDING"
          ],
          "to": "DENIED",
          "on": "ApprovalService.DecideApproval deny"
        },
        {
          "from": [
            "PENDING"
          ],
          "to": "EXPIRED",
          "on": "approval TTL elapsed (default 24 h)"
        },
        {
          "from": [
            "PENDING"
          ],
          "to": "CANCELLED",
          "on": "ApprovalService.CancelApproval"
        }
      ]
    },
    {
      "id": "SM-SIGN-IN",
      "title": "Node browser sign-in (cloud side)",
      "enum": "arcforges.fleet.v1.NodeSignInState",
      "persisted": "cloud fleet_node_sign_in.state; node mirrors as SignInFlowState",
      "owner": "Fleet module",
      "initial": [
        "PENDING"
      ],
      "terminal": [
        "COMPLETED",
        "DENIED",
        "EXPIRED",
        "REVOKED"
      ],
      "transitions": [
        {
          "from": [
            "PENDING"
          ],
          "to": "APPROVED",
          "on": "NodeEnrollmentService.ApproveNodeSignIn approve",
          "effect": "one-use code issued; browser redirected to the loopback URI"
        },
        {
          "from": [
            "PENDING"
          ],
          "to": "DENIED",
          "on": "NodeEnrollmentService.ApproveNodeSignIn deny"
        },
        {
          "from": [
            "APPROVED"
          ],
          "to": "COMPLETED",
          "on": "NodeEnrollmentService.CompleteNodeSignIn with a valid code and verifier",
          "effect": "installation registered; credentials issued"
        },
        {
          "from": [
            "APPROVED"
          ],
          "to": "REVOKED",
          "on": "code presented twice"
        },
        {
          "from": [
            "PENDING",
            "APPROVED"
          ],
          "to": "EXPIRED",
          "on": "10 minutes elapsed"
        }
      ]
    },
    {
      "id": "SM-DEVICE-AUTH",
      "title": "Device authorization (headless sign-in)",
      "enum": "arcforges.fleet.v1.DeviceAuthorizationState",
      "response_only": [
        "SLOW_DOWN"
      ],
      "persisted": "cloud fleet_device_authorization.state",
      "owner": "Fleet module",
      "initial": [
        "PENDING"
      ],
      "terminal": [
        "COMPLETED",
        "DENIED",
        "EXPIRED"
      ],
      "transitions": [
        {
          "from": [
            "PENDING"
          ],
          "to": "APPROVED",
          "on": "NodeEnrollmentService.ApproveDeviceCode approve"
        },
        {
          "from": [
            "PENDING"
          ],
          "to": "DENIED",
          "on": "NodeEnrollmentService.ApproveDeviceCode deny; 5 failed code entries"
        },
        {
          "from": [
            "APPROVED"
          ],
          "to": "COMPLETED",
          "on": "PollDeviceAuthorization delivered credentials"
        },
        {
          "from": [
            "PENDING",
            "APPROVED"
          ],
          "to": "EXPIRED",
          "on": "600 s elapsed"
        }
      ]
    },
    {
      "id": "SM-PHONE-PAIRING",
      "title": "Phone sign-in by QR",
      "enum": "arcforges.fleet.v1.PhonePairingCloudState",
      "persisted": "cloud fleet_phone_pairing.state; node mirrors as PhonePairingState",
      "owner": "Fleet module",
      "initial": [
        "WAITING_FOR_SCAN"
      ],
      "terminal": [
        "COMPLETED",
        "DENIED",
        "EXPIRED",
        "CONSUMED"
      ],
      "transitions": [
        {
          "from": [
            "WAITING_FOR_SCAN"
          ],
          "to": "AWAITING_CONFIRMATION",
          "on": "NodeEnrollmentService.ClaimPhonePairing with the right secret"
        },
        {
          "from": [
            "WAITING_FOR_SCAN"
          ],
          "to": "CONSUMED",
          "on": "a wrong secret was presented"
        },
        {
          "from": [
            "AWAITING_CONFIRMATION"
          ],
          "to": "CONFIRMED",
          "on": "NodeEnrollmentService.ConfirmPhonePairing approve (desktop user)"
        },
        {
          "from": [
            "AWAITING_CONFIRMATION"
          ],
          "to": "DENIED",
          "on": "NodeEnrollmentService.ConfirmPhonePairing deny"
        },
        {
          "from": [
            "CONFIRMED"
          ],
          "to": "COMPLETED",
          "on": "PollPhonePairing delivered the phone credentials"
        },
        {
          "from": [
            "WAITING_FOR_SCAN",
            "AWAITING_CONFIRMATION",
            "CONFIRMED"
          ],
          "to": "EXPIRED",
          "on": "120 s elapsed"
        }
      ]
    },
    {
      "id": "SM-RELAY",
      "title": "Relay connection (node side) (since 2026-10-28 the node's connection to the Go center, AD-0021 §9)",
      "enum": "arcforges.node.v1.RelayState",
      "persisted": "in memory; reported in AccountStatus",
      "owner": "Cloud link",
      "initial": [
        "DISABLED"
      ],
      "terminal": [],
      "transitions": [
        {
          "from": [
            "DISABLED"
          ],
          "to": "CONNECTING",
          "on": "signed in, cloud link enabled, entitlement relay"
        },
        {
          "from": [
            "CONNECTING"
          ],
          "to": "CONNECTED",
          "on": "token issued, WebSocket accepted, NodeHello acknowledged"
        },
        {
          "from": [
            "CONNECTING",
            "CONNECTED"
          ],
          "to": "BACKOFF",
          "on": "network failure; close 4401, 4408 or 4429; container unavailable"
        },
        {
          "from": [
            "BACKOFF"
          ],
          "to": "CONNECTING",
          "on": "jittered backoff 1 s to 60 s"
        },
        {
          "from": [
            "CONNECTING",
            "CONNECTED"
          ],
          "to": "REFUSED",
          "on": "ENTITLEMENT, plan limit, kill switch, unsupported version (close 4403 or 4503)"
        },
        {
          "from": [
            "REFUSED"
          ],
          "to": "CONNECTING",
          "on": "entitlement changed, or 1 h elapsed"
        },
        {
          "from": [
            "CONNECTING",
            "CONNECTED",
            "BACKOFF",
            "REFUSED"
          ],
          "to": "DISABLED",
          "on": "AccountService.SetCloudLink false; sign-out; node revoked"
        }
      ]
    },
    {
      "id": "SM-REMOTE-COMMAND",
      "title": "Remote command (since 2026-10-28 center-routed signed calls, AD-0021 §10)",
