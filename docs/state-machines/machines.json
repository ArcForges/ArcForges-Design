        "TRIALING"
      ],
      "terminal": [
        "EXPIRED",
        "REVOKED"
      ],
      "transitions": [
        {
          "from": [
            "PENDING"
          ],
          "to": "ACTIVE",
          "on": "payment completed (Play purchase PURCHASED; Paddle subscription active)"
        },
        {
          "from": [
            "PENDING"
          ],
          "to": "EXPIRED",
          "on": "pending purchase cancelled"
        },
        {
          "from": [
            "TRIALING"
          ],
          "to": "ACTIVE",
          "on": "trial converted"
        },
        {
          "from": [
            "TRIALING"
          ],
          "to": "EXPIRED",
          "on": "trial ended without payment"
        },
        {
          "from": [
            "ACTIVE"
          ],
          "to": "PAYMENT_ISSUE",
          "on": "Paddle past_due; Play grace period"
        },
        {
          "from": [
            "PAYMENT_ISSUE"
          ],
          "to": "ACTIVE",
          "on": "payment recovered"
        },
        {
          "from": [
            "PAYMENT_ISSUE"
          ],
          "to": "ON_HOLD",
          "on": "Play account hold"
        },
        {
          "from": [
            "ON_HOLD"
          ],
          "to": "ACTIVE",
          "on": "payment recovered"
        },
        {
          "from": [
            "ACTIVE"
          ],
          "to": "PAUSED",
          "on": "provider pause"
        },
        {
          "from": [
            "PAUSED"
          ],
          "to": "ACTIVE",
          "on": "pause ended"
        },
        {
          "from": [
            "ACTIVE",
            "PAYMENT_ISSUE"
          ],
          "to": "CANCELED_ACTIVE",
          "on": "cancellation scheduled at period end"
        },
        {
          "from": [
            "CANCELED_ACTIVE"
          ],
          "to": "ACTIVE",
          "on": "reactivated before period end"
        },
        {
          "from": [
            "CANCELED_ACTIVE",
            "PAYMENT_ISSUE",
            "ON_HOLD",
            "PAUSED"
          ],
