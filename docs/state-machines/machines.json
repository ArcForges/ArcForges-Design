    {
      "id": "SM-UPDATE",
      "title": "Node update",
      "enum": "arcforges.node.v1.UpdateState",
      "persisted": "node store update_state.state; run/update-switch.json during a switch",
      "owner": "Updater",
      "initial": [
        "IDLE",
        "MANAGED_EXTERNALLY"
      ],
      "terminal": [
        "MANAGED_EXTERNALLY"
      ],
      "transitions": [
        {
          "from": [
            "IDLE"
          ],
          "to": "CHECKING",
          "on": "6-hour timer; UpdateService.CheckNow"
        },
        {
          "from": [
            "CHECKING"
          ],
          "to": "IDLE",
          "on": "no newer non-revoked version"
        },
        {
          "from": [
            "CHECKING"
          ],
          "to": "DOWNLOADING",
          "on": "newer version and mode AUTO (or CheckNow under NOTIFY)"
        },
        {
          "from": [
            "CHECKING",
            "DOWNLOADING"
          ],
          "to": "FAILED",
          "on": "manifest refused (signature, expiry, rollback protection) or digest mismatch"
        },
        {
          "from": [
            "DOWNLOADING"
          ],
          "to": "STAGED",
          "on": "verified, extracted, staged self-test passed"
        },
        {
          "from": [
            "STAGED"
          ],
          "to": "PENDING_RESTART",
          "on": "policy window open; restart announced"
        },
        {
          "from": [
            "STAGED",
            "PENDING_RESTART"
          ],
          "to": "SWITCHING",
          "on": "countdown ended; UpdateService.ApplyNow"
        },
        {
          "from": [
            "PENDING_RESTART"
          ],
          "to": "STAGED",
          "on": "UpdateService.Postpone"
        },
        {
          "from": [
            "SWITCHING"
          ],
          "to": "VERIFYING",
          "on": "new version started"
        },
        {
          "from": [
            "VERIFYING"
          ],
          "to": "IDLE",
          "on": "health check passed within 120 s",
          "effect": "new version ACTIVE; previous kept"
        },
        {
          "from": [
            "VERIFYING",
            "SWITCHING"
          ],
          "to": "ROLLED_BACK",
          "on": "health check failed, crash loop, store incompatibility",
          "effect": "finding UPDATE_FAILED; version marked BAD"
        },
        {
          "from": [
            "IDLE"
          ],
          "to": "SWITCHING",
          "on": "UpdateService.Rollback (to the previous version)"
        },
        {
          "from": [
            "ROLLED_BACK",
            "FAILED"
          ],
          "to": "IDLE",
          "on": "next check cycle"
        }
      ]
    },
    {
      "id": "SM-INTEGRATION",
      "title": "AI client integration",
      "enum": "arcforges.node.v1.IntegrationState",
      "persisted": "derived from integration_write, client settings and probes (re-evaluated by file watchers)",
      "owner": "Integration service",
      "initial": [
        "CLIENT_NOT_FOUND",
        "NOT_CONFIGURED"
      ],
      "terminal": [],
      "transitions": [
        {
          "from": [
            "CLIENT_NOT_FOUND"
          ],
          "to": "NOT_CONFIGURED",
          "on": "client detected"
        },
        {
          "from": [
            "NOT_CONFIGURED",
            "PARTIAL"
          ],
          "to": "CONFIGURED",
          "on": "IntegrationService.ApplyIntegration (all selected components)"
        },
        {
          "from": [
            "NOT_CONFIGURED"
          ],
          "to": "PARTIAL",
          "on": "IntegrationService.ApplyIntegration (subset of components)"
        },
        {
          "from": [
            "CONFIGURED",
            "PARTIAL"
          ],
          "to": "DEGRADED",
          "on": "conflict detected: hooks disabled or untrusted, probe failed, configuration edited away"
        },
        {
          "from": [
            "DEGRADED"
          ],
          "to": "CONFIGURED",
          "on": "conflict resolved and re-checked"
        },
        {
          "from": [
            "CONFIGURED",
            "PARTIAL",
            "DEGRADED"
          ],
          "to": "NOT_CONFIGURED",
          "on": "removal plan applied"
        },
        {
          "from": [
            "NOT_CONFIGURED",
            "CONFIGURED",
            "PARTIAL",
            "DEGRADED"
          ],
          "to": "CLIENT_NOT_FOUND",
          "on": "client uninstalled"
        }
      ]
    }
  ]
}
