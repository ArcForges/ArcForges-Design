<Project Sdk="Microsoft.NET.Sdk">
  <!-- Restores the pinned protoc (Grpc.Tools) and the runtime packages used by tools/check_design.py.
       No code. Restore it in locked mode before running the checks (see README). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.Tools" Version="2.84.0" PrivateAssets="all" />
    <PackageReference Include="Google.Protobuf" Version="3.36.1" />
    <PackageReference Include="Grpc.Core.Api" Version="2.84.0" />
  </ItemGroup>
</Project>
