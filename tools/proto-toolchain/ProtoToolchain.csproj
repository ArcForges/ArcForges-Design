<Project Sdk="Microsoft.NET.Sdk">
  <!-- Restores the pinned protoc (Grpc.Tools) and the runtime packages used by tools/check_design.py.
       No code. Restore it in locked mode before running the checks (see README). -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.Tools" Version="2.85.0" PrivateAssets="all" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Core.Api" Version="2.85.0" />
  </ItemGroup>
</Project>
